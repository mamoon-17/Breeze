# Backend API URL — point to your running Breeze NestJS instance.
# Local dev (Vite): http://localhost:3000
# Docker / Render image (nginx + SPA): /api  (use origin-relative path, not a full /api URL)
# Socket.IO always connects to /socket.io on the same host, not under /api.
VITE_API_URL=http://localhost:3000

# Web Push VAPID public key (base64 URL-safe).
# Must match the VAPID_PUBLIC_KEY configured on the backend.
# Generate a pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
